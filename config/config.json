{
  "schema": 1,
  "stages": [
    "flux",
    "cutout",
    "trellis",
    "textures",
    "bind",
    "upscale",
    "stills",
    "publish"
  ],
  "limits": {
    "guard_min_free_ram_gb": 3,
    "guard_max_gpu_gb": 0,
    "max_megapixels": 1.6,
    "watchdog_seconds": 1500,
    "start_min_free_ram_gb": 6,
    "start_wait_max_s": 1800
  },
  "models": {
    "flux": {
      "id": "flux-3-image-klein",
      "dtype": "bfloat16",
      "vae_slicing": true,
      "vae_tiling": true
    }
  },
  "defaults": {
    "seed": 42,
    "w": 1024,
    "h": 1024
  },
  "presets": {},
  "trellis": {
    "cutout_model": "ZhengPeng7/BiRefNet (cpu)",
    "env": {
      "ATTN_BACKEND": "sdpa",
      "SPARSE_ATTN_BACKEND": "sdpa",
      "SPARSE_CONV_BACKEND": "flex_gemm",
      "TRELLIS3_OVOXEL": "native",
      "HF_HUB_OFFLINE": "1",
      "TRELLIS3_REMBG": "none",
      "PYTHONUNBUFFERED": "1"
    },
    "presets": {
      "master_reduced": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "28"
        ]
      },
      "attn24": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "24"
        ]
      },
      "tokens98k": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "24",
          "--max-tokens",
          "98304"
        ]
      },
      "plain": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": []
      },
      "hero_rebake": {
        "preset": "master",
        "texture_size": 8192,
        "bake_faces": 2000000,
        "extra": []
      },
      "tokens98k_fresh": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "24",
          "--max-tokens",
          "98304"
        ]
      },
      "game_lod0": {
        "preset": "master",
        "texture_size": 4096,
        "bake_faces": 1000000,
        "extra": []
      },
      "head_master": {
        "preset": "master",
        "texture_size": 4096,
        "bake_faces": 1000000,
        "extra": [
          "--attn-auto-gb",
          "28",
          "--max-tokens",
          "98304"
        ]
      },
      "part_512": {
        "preset": "final",
        "texture_size": 2048,
        "bake_faces": 40000,
        "extra": [
          "--pipeline-type",
          "512"
        ]
      }
    }
  },
  "textures": {
    "subdir": "textures",
    "timeout_s": 600,
    "min_free_ram_gb": 2.5,
    "hole_max_value": 14,
    "hole_max_area": 400,
    "normal_strength": 2.5,
    "compare": {
      "crop_px": 512,
      "zoom": 2,
      "_comment": "crops: height band [lo, hi] as a fraction of the mesh height; the crop is placed where most UV points of the band vertices fall",
      "crops": {
        "face": [
          0.88,
          0.97
        ],
        "coat": [
          0.4,
          0.7
        ]
      }
    }
  },
  "qc": {
    "min_free_ram_gb": 2.5,
    "timeout_s": 600,
    "_comment": "tools/run_qc.py thresholds, loose to start; tune from real receipts. A metric whose limit is null, or whose input is missing (no concept, no budget), is skipped, not failed.",
    "geometry": {
      "max_non_manifold_edge_pct": 8.0,
      "max_boundary_edge_pct": 10.0,
      "max_loose_shells": 200,
      "budget_tris": null,
      "budget_tolerance": 1.0,
      "max_faceting_deg": 25.0
    },
    "texture": {
      "max_raster_px": 2048,
      "near_black_value": 14,
      "max_near_black_pct": 0.2,
      "max_black_patch_pct": 0.03,
      "min_uv_coverage": 0.3,
      "max_uv_stretch_p99": 12.0,
      "max_uv_degenerate_pct": 10.0,
      "min_luminance_ratio": 0.6,
      "min_saturation_ratio": 0.15
    },
    "thin": {
      "raster_px": 512,
      "iou_px": 256,
      "min_coverage_ratio": 0.8,
      "min_iou": 0.4
    }
  },
  "bind": {
    "script_dir": "bind",
    "best_script": "bind_best.py",
    "bound_glb_name": "bound.glb",
    "work_subdir": "bind_work",
    "timeout_s": 1800,
    "export_timeout_s": 300,
    "rig_name": "Rig",
    "body_name": "Body",
    "gate": {
      "min_edge_mm": 5,
      "p99_stretch_max": 2.0,
      "p99_compression_ratio_min": 0.5,
      "zero_weight_vertices_max": 0,
      "max_influences": 4,
      "weight_sum_tol": 0.001
    }
  },
  "clean": {
    "_comment": "fallback pre-bind mesh clean (tools/run_clean.py -> bind/clean_mesh.py); distances in metres; voxel_m 0 = voxel remesh off (then the original texture is kept as is)",
    "script_dir": "bind",
    "script": "clean_mesh.py",
    "out_name": "clean.glb",
    "timeout_s": 480,
    "merge_dist_m": 0.0002,
    "min_shell_verts": 200,
    "count_weld_m": 1e-06,
    "voxel_m": 0,
    "tex_size": 2048,
    "bake_margin_px": 8,
    "bake_extrude_m": 0.01
  },
  "gear": {
    "script": "bind_gear.py",
    "glb_prefix": "gear_",
    "work_subdir": "gear_work",
    "timeout_s": 1800,
    "max_influences": 4,
    "weight_epsilon": 0.0001,
    "smooth_passes": 2,
    "smooth_factor": 0.5,
    "stretch_clips": [
      "idle",
      "walk",
      "attack"
    ],
    "stretch_frames_per_clip": 6,
    "fit": {
      "mode": "none",
      "_comment": "mode 'z_frac' scales each gear mesh uniformly so its height spans the body height fraction below and centres it on the body in x/y; mode 'none' trusts the incoming scale and placement",
      "parts": {
        "coat": {
          "z_frac": [
            0.3,
            0.85
          ]
        },
        "cloak": {
          "z_frac": [
            0.25,
            0.88
          ]
        },
        "boots": {
          "z_frac": [
            0.0,
            0.3
          ]
        }
      }
    },
    "helpers": {
      "_comment": "optional secondary motion: gear vertices below anchor_z_frac of body height shift up to max_blend of their weight onto the nearest rig helper bone whose lower-case name contains a pattern",
      "parts": {
        "cloak": {
          "patterns": [
            "cape"
          ],
          "max_blend": 0.8,
          "anchor_z_frac": 0.8
        },
        "coat": {
          "patterns": [
            "skirt"
          ],
          "max_blend": 0.6,
          "anchor_z_frac": 0.55
        }
      }
    },
    "gate": {
      "min_edge_mm": 5,
      "p99_stretch_max": 3.0,
      "zero_weight_vertices_max": 0,
      "max_influences": 4,
      "weight_sum_tol": 0.001
    }
  },
  "assemble": {
    "timeout_s": 900,
    "output_name": "{asset_id}.glb",
    "work_subdir": "assemble_work",
    "expected_bones": 106,
    "export": {
      "export_format": "GLB",
      "use_selection": true,
      "export_apply": false,
      "export_skins": true,
      "export_all_influences": false,
      "export_def_bones": false,
      "export_animations": false,
      "export_morph": false,
      "export_draco_mesh_compression_enable": false,
      "export_normals": true,
      "export_tangents": false,
      "export_texcoords": true,
      "export_image_format": "AUTO",
      "export_yup": true
    }
  },
  "stills": {
    "subdir": "stills",
    "timeout_s": 1800,
    "clips": {
      "idle": "113410901-idle",
      "walk": "124540901-walk",
      "attack": "9034009-zombie-neck-bite"
    },
    "clip_ext": ".glb",
    "clip_frame": "mid",
    "engine": "CYCLES",
    "device": "CPU",
    "samples": 24,
    "denoise": false,
    "threads": 0,
    "width": 1024,
    "height": 1024,
    "thumb_px": 256,
    "thumb_source": "idle",
    "lens_mm": 50,
    "sensor_mm": 36,
    "body_margin": 1.2,
    "head_height_frac": 0.18,
    "head_bone": "mixamorig:Head",
    "hips_bone": "mixamorig:Hips",
    "camera_dir": [
      0,
      -1,
      0
    ],
    "cam_height_frac": 0.5,
    "sun_energy": 3.0,
    "sun_euler_deg": [
      50,
      0,
      35
    ],
    "world_color": [
      0.18,
      0.2,
      0.24
    ],
    "world_strength": 1.0,
    "rig_name": "Rig",
    "clip_action_name": "clip",
    "lit": {
      "_comment": "Lit PBR presentation look (run_stills.py). Light positions are in units of body height H from the rest-pose bounds: x,y from the bounds centre (camera looks along +Y from -Y), z from the feet. size is in H. energy is watts at ref_height_m and scales with (H/ref_height_m)^2. Set enabled false for the old flat sun look.",
      "enabled": true,
      "width": 1080,
      "height": 1080,
      "samples": 64,
      "denoise": true,
      "denoiser": "OPENIMAGEDENOISE",
      "clamp_indirect": 8.0,
      "ref_height_m": 1.8,
      "aim_z_frac": 0.55,
      "view_transform": "AgX",
      "exposure": 0.0,
      "world_color": [
        0.02,
        0.022,
        0.03
      ],
      "world_strength": 0.4,
      "lights": [
        {
          "name": "key",
          "energy": 1100,
          "size": 0.9,
          "temp_k": 5200,
          "pos": [
            -0.9,
            -1.1,
            1.1
          ]
        },
        {
          "name": "fill",
          "energy": 280,
          "size": 1.4,
          "temp_k": 7800,
          "pos": [
            1.2,
            -1.0,
            0.55
          ]
        },
        {
          "name": "rim",
          "energy": 900,
          "size": 0.7,
          "temp_k": 9500,
          "pos": [
            0.7,
            1.3,
            1.0
          ]
        }
      ],
      "backdrop": {
        "width_h": 8.0,
        "floor_front_h": 5.0,
        "floor_back_h": 1.8,
        "curve_radius_h": 1.2,
        "wall_height_h": 3.5,
        "color_bottom": [
          0.012,
          0.012,
          0.016
        ],
        "color_mid": [
          0.05,
          0.055,
          0.075
        ],
        "color_top": [
          0.006,
          0.006,
          0.01
        ],
        "mid_offset": 0.12,
        "side_falloff": 0.6,
        "roughness": 0.5
      },
      "turntable": {
        "pose": "idle",
        "frames": 72,
        "width": 720,
        "height": 720,
        "samples": 32,
        "fps": 24,
        "crf": 18,
        "frames_subdir": "turntable_frames",
        "frame_pattern": "frame_%04d.png",
        "mp4": "turntable.mp4",
        "timeout_s": 10800,
        "ffmpeg_timeout_s": 600,
        "start_deg": 0
      }
    }
  },
  "character": {
    "_comment": "tools/run_character.py: stage names in run order; pauses and timeouts in seconds",
    "stages": [
      "flux",
      "trellis",
      "bind",
      "stills_body",
      "gear",
      "assemble",
      "stills_dressed",
      "textures"
    ],
    "pause_s": 15,
    "flux_timeout_s": 1800,
    "trellis_timeout_s": 7200,
    "cpu_timeout_s": 3600,
    "default_preset": "master_reduced",
    "default_donor": "tall",
    "stills_body_suffix": "-bodystills",
    "stills_dressed_suffix": "-dressed",
    "stage_times_name": "stage_times.json",
    "summary_name": "stage_times.txt",
    "library_row_name": "library_row.json",
    "markers_subdir": "char_markers",
    "guard_match": {
      "flux": "flux_kit",
      "trellis": "generate.py"
    },
    "guard_wait_s": 2,
    "log_prefix": "char_"
  }
}
