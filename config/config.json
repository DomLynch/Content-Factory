{
  "schema": 1,
  "stages": [
    "flux",
    "cutout",
    "trellis",
    "textures",
    "bind",
    "upscale",
    "stills",
    "publish"
  ],
  "limits": {
    "guard_min_free_ram_gb": 3,
    "guard_max_gpu_gb": 0,
    "max_megapixels": 1.6,
    "watchdog_seconds": 1500,
    "start_min_free_ram_gb": 6,
    "start_wait_max_s": 1800
  },
  "models": {
    "flux": {
      "id": "flux-3-image-klein",
      "dtype": "bfloat16",
      "vae_slicing": true,
      "vae_tiling": true
    }
  },
  "defaults": {
    "seed": 42,
    "w": 1024,
    "h": 1024
  },
  "presets": {},
  "trellis": {
    "cutout_model": "ZhengPeng7/BiRefNet (cpu)",
    "env": {
      "ATTN_BACKEND": "sdpa",
      "SPARSE_ATTN_BACKEND": "sdpa",
      "SPARSE_CONV_BACKEND": "flex_gemm",
      "TRELLIS3_OVOXEL": "native",
      "HF_HUB_OFFLINE": "1",
      "TRELLIS3_REMBG": "none",
      "PYTHONUNBUFFERED": "1"
    },
    "presets": {
      "master_reduced": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "28"
        ]
      },
      "attn24": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "24"
        ]
      },
      "tokens98k": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "24",
          "--max-tokens",
          "98304"
        ]
      },
      "plain": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": []
      },
      "hero_rebake": {
        "preset": "master",
        "texture_size": 8192,
        "bake_faces": 2000000,
        "extra": []
      },
      "tokens98k_fresh": {
        "preset": "master",
        "texture_size": 2048,
        "bake_faces": 500000,
        "extra": [
          "--attn-auto-gb",
          "24",
          "--max-tokens",
          "98304"
        ]
      }
    }
  },
  "textures": {
    "subdir": "textures",
    "timeout_s": 600,
    "min_free_ram_gb": 2.5,
    "hole_max_value": 14,
    "hole_max_area": 400,
    "normal_strength": 2.5,
    "compare": {
      "crop_px": 512,
      "zoom": 2,
      "_comment": "crops: height band [lo, hi] as a fraction of the mesh height; the crop is placed where most UV points of the band vertices fall",
      "crops": {
        "face": [
          0.88,
          0.97
        ],
        "coat": [
          0.4,
          0.7
        ]
      }
    }
  },
  "bind": {
    "script_dir": "bind",
    "best_script": "bind_best.py",
    "bound_glb_name": "bound.glb",
    "work_subdir": "bind_work",
    "timeout_s": 1800,
    "export_timeout_s": 300,
    "rig_name": "Rig",
    "body_name": "Body",
    "gate": {
      "min_edge_mm": 5,
      "p99_stretch_max": 2.0,
      "p99_compression_ratio_min": 0.5,
      "zero_weight_vertices_max": 0,
      "max_influences": 4,
      "weight_sum_tol": 0.001
    }
  },
  "skin_tokens": {
    "_comment": "tools/run_skin_tokens.py: SkinTokens (VAST-AI, MIT) skins a body onto the psyche-106 rig (demo.py --use_skeleton). GPU. Paths come from config.local.json (skin_tokens_repo_dir, skin_tokens_python). Gate = bind.gate plus the relative-to-control clause.",
    "script_dir": "tools/skin_tokens",
    "prep_script": "prep_input.py",
    "export_script": "to_rig_body.py",
    "metrics_script": "bind/metrics2.py",
    "ckpt": "experiments/articulation_xl_quantization_256_token_4/grpo_1400.ckpt",
    "vae_ckpt": "experiments/skin_vae_2_10_32768/last.ckpt",
    "work_subdir": "skin_tokens_work",
    "bound_glb_name": "bound_skintokens.glb",
    "use_transfer": true,
    "clamp_influences": true,
    "num_beams": 10,
    "top_k": 5,
    "top_p": 0.95,
    "temperature": 1.0,
    "repetition_penalty": 2.0,
    "control_donor": "tall",
    "control_json": "bind/controls/control_{donor}.metrics.json",
    "relative": {"stretch_factor": 1.10, "compression_factor": 0.90},
    "prep_timeout_s": 300,
    "run_timeout_s": 1800,
    "export_timeout_s": 300,
    "metrics_timeout_s": 900,
    "attn_env": {"SKINTOKENS_ATTN": "sdpa"}
  },
  "qc": {
    "min_free_ram_gb": 2.5,
    "timeout_s": 600,
    "_comment": "tools/run_qc.py thresholds, loose to start; tune from real receipts. A metric whose limit is null, or whose input is missing (no concept, no budget), is skipped, not failed.",
    "geometry": {
      "max_non_manifold_edge_pct": 8.0,
      "max_boundary_edge_pct": 10.0,
      "max_loose_shells": 200,
      "budget_tris": null,
      "budget_tolerance": 1.0,
      "max_faceting_deg": 25.0
    },
    "texture": {
      "max_raster_px": 2048,
      "near_black_value": 14,
      "max_near_black_pct": 0.2,
      "max_black_patch_pct": 0.03,
      "min_uv_coverage": 0.3,
      "max_uv_stretch_p99": 12.0,
      "max_uv_degenerate_pct": 10.0,
      "min_luminance_ratio": 0.6,
      "min_saturation_ratio": 0.15
    },
    "thin": {
      "raster_px": 512,
      "iou_px": 256,
      "min_coverage_ratio": 0.8,
      "min_iou": 0.4
    },
    "moge": {
      "_comment": "Optional MoGe-2 input (tools/qc_moge.py, plugin 0.1.13): faceting of --render against the concept and normal/depth agreement. OFF by default; when off or unavailable qc behaves as before. Thresholds null = scores are recorded in params.moge but never fail. Definitions: docstring of tools/qc_moge.py. Weights: local only (model_dir null = config.local pixal3d_moge_dir, else work_dir/models/moge-2-vitl). Python: config.local moge_python (default the Pixal3D venv). CPU by default so it never takes the GPU lock.",
      "enabled": false,
      "model_dir": null,
      "device": "cpu",
      "min_free_ram_gb": 8.0,
      "timeout_s": 600,
      "resolution_level": 9,
      "score_px": 96,
      "erode_px": 1,
      "crease_deg": 15.0,
      "thresholds": {
        "max_faceting_delta_deg": null,
        "max_normal_mean_deg": null,
        "max_depth_rel_err": null,
        "min_mask_iou": null
      }
    }
  },
  "clean": {
    "_comment": "fallback pre-bind mesh clean (tools/run_clean.py -> bind/clean_mesh.py); distances in metres; voxel_m 0 = voxel remesh off (then the original texture is kept as is)",
    "script_dir": "bind",
    "script": "clean_mesh.py",
    "out_name": "clean.glb",
    "timeout_s": 480,
    "merge_dist_m": 0.0002,
    "min_shell_verts": 200,
    "count_weld_m": 1e-06,
    "voxel_m": 0,
    "tex_size": 2048,
    "bake_margin_px": 8,
    "bake_extrude_m": 0.01
  },
  "gear": {
    "script": "bind_gear.py",
    "glb_prefix": "gear_",
    "work_subdir": "gear_work",
    "timeout_s": 1800,
    "max_influences": 4,
    "weight_epsilon": 0.0001,
    "smooth_passes": 2,
    "smooth_factor": 0.5,
    "stretch_clips": [
      "idle",
      "walk",
      "attack"
    ],
    "stretch_frames_per_clip": 6,
    "fit": {
      "mode": "none",
      "_comment": "mode 'z_frac' scales each gear mesh uniformly so its height spans the body height fraction below and centres it on the body in x/y; mode 'none' trusts the incoming scale and placement",
      "parts": {
        "coat": {
          "z_frac": [
            0.3,
            0.85
          ]
        },
        "cloak": {
          "z_frac": [
            0.25,
            0.88
          ]
        },
        "boots": {
          "z_frac": [
            0.0,
            0.3
          ]
        }
      }
    },
    "helpers": {
      "_comment": "optional secondary motion: gear vertices below anchor_z_frac of body height shift up to max_blend of their weight onto the nearest rig helper bone whose lower-case name contains a pattern",
      "parts": {
        "cloak": {
          "patterns": [
            "cape"
          ],
          "max_blend": 0.8,
          "anchor_z_frac": 0.8
        },
        "coat": {
          "patterns": [
            "skirt"
          ],
          "max_blend": 0.6,
          "anchor_z_frac": 0.55
        }
      }
    },
    "gate": {
      "min_edge_mm": 5,
      "p99_stretch_max": 3.0,
      "zero_weight_vertices_max": 0,
      "max_influences": 4,
      "weight_sum_tol": 0.001
    }
  },
  "assemble": {
    "timeout_s": 900,
    "output_name": "{asset_id}.glb",
    "work_subdir": "assemble_work",
    "expected_bones": 106,
    "export": {
      "export_format": "GLB",
      "use_selection": true,
      "export_apply": false,
      "export_skins": true,
      "export_all_influences": false,
      "export_def_bones": false,
      "export_animations": false,
      "export_morph": false,
      "export_draco_mesh_compression_enable": false,
      "export_normals": true,
      "export_tangents": false,
      "export_texcoords": true,
      "export_image_format": "AUTO",
      "export_yup": true
    }
  },
  "stills": {
    "subdir": "stills",
    "lighting_tier": "proof",
    "timeout_s": 1800,
    "clips": {
      "idle": "113410901-idle",
      "walk": "124540901-walk",
      "attack": "9034009-zombie-neck-bite"
    },
    "clip_ext": ".glb",
    "clip_frame": "mid",
    "engine": "CYCLES",
    "device": "CPU",
    "samples": 24,
    "denoise": false,
    "threads": 0,
    "width": 1024,
    "height": 1024,
    "thumb_px": 256,
    "thumb_source": "idle",
    "lens_mm": 50,
    "sensor_mm": 36,
    "body_margin": 1.2,
    "head_height_frac": 0.18,
    "head_bone": "mixamorig:Head",
    "hips_bone": "mixamorig:Hips",
    "camera_dir": [
      0,
      -1,
      0
    ],
    "cam_height_frac": 0.5,
    "sun_energy": 3.0,
    "sun_euler_deg": [
      50,
      0,
      35
    ],
    "world_color": [
      0.18,
      0.2,
      0.24
    ],
    "world_strength": 1.0,
    "rig_name": "Rig",
    "clip_action_name": "clip"
  },
  "character": {
    "_comment": "tools/run_character.py: stage names in run order; pauses and timeouts in seconds",
    "stages": [
      "flux",
      "trellis",
      "bind",
      "stills_body",
      "gear",
      "assemble",
      "stills_dressed",
      "textures"
    ],
    "pause_s": 15,
    "flux_timeout_s": 1800,
    "trellis_timeout_s": 7200,
    "cpu_timeout_s": 3600,
    "default_preset": "master_reduced",
    "default_donor": "tall",
    "stills_body_suffix": "-bodystills",
    "stills_dressed_suffix": "-dressed",
    "stage_times_name": "stage_times.json",
    "summary_name": "stage_times.txt",
    "library_row_name": "library_row.json",
    "markers_subdir": "char_markers",
    "guard_match": {
      "flux": "flux_kit",
      "trellis": "generate.py"
    },
    "guard_wait_s": 2,
    "log_prefix": "char_"
  },
  "flux": {
    "_comment": "plugin 0.1.6; names agreed with the Factory (flux_kit_fast.py). steps and ref_long_by_group are the quality policy (plugins/factory/lib/cf_flux.py): ref_long_by_group 0 = full-size reference required, N = long side may drop to N. The rest are speed switches, zero pixel change: env CF_ATTN_BACKEND, CF_VAE_TILING, CF_VAE_SLICING, CF_CACHE_REF, CF_INPROC override them; vae_tiling/vae_slicing null = models.flux.",
    "steps": 16,
    "ref_long_by_group": {"body": 0, "head": 0, "hands_feet": 0, "gear": 640, "swatch": 640},
    "attention_backend": "native",
    "single_process_queue": true,
    "cache_ref_conds": true,
    "vae_tiling": null,
    "vae_slicing": null
  },
  "pixal3d": {
    "_comment": "plugin 0.1.10. Pixal3D (TencentARC, MIT) single view via tools/run_pixal3d.py. Attention is sdpa (flash-attn and natten are CUDA-only; NAF, loaded by torch.hub, imports natten: see tools/pixal3d_shims). Paths under config.local.json (pixal3d_*), defaults under work_dir. Presets are first settings: the A/B against TRELLIS on the same input and seed decides.",
    "default_preset": "standard",
    "timeout_s": 3600,
    "guard_match": "pixal3d_entry",
    "naf": true,
    "naf_off_label": "ROUGH / NAF-off",
    "shim_dir": "pixal3d_shims",
    "_naf_comment": "plugin 0.1.15. naf true = NAF feature upsampler (torch.hub valeoai/NAF, needs natten: tools/pixal3d_shims/natten is a pure-PyTorch stand-in, first on sys.path). false = bicubic feature upsample, no hub, no natten; the receipt then carries params.naf=false and params.quality_label (a rough proof, never a final). Hub cache = config.local pixal3d_torch_home, default work_dir/models/torch-hub (code in hub/valeoai_NAF_main, checkpoint in hub/checkpoints/naf_release.pth).",
    "env": {
      "ATTN_BACKEND": "sdpa",
      "SPARSE_ATTN_BACKEND": "sdpa",
      "SPARSE_CONV_BACKEND": "flex_gemm",
      "HF_HUB_OFFLINE": "1",
      "PYTHONUNBUFFERED": "1"
    },
    "presets": {
      "draft": {"resolution": 1024, "low_vram": true},
      "standard": {"resolution": 1024, "low_vram": true},
      "master": {"resolution": 1536, "low_vram": true}
    }
  },
  "ab": {
    "_comment": "plugin 0.1.14: A/B harness Pixal3D vs TRELLIS (tools/run_ab.py, tool ab_shape). Decision rule from OpenTrident Dev: same cut-out PNG, same seed, about 10 min wall each (wall_budget_s is REPORTED, not a kill; wall_hard_cap_s is the safety kill), TRELLIS first, one GPU job at a time under the lock; blind scores 0-10 on face, hair, colour match, bake faults; Pixal3D wins only if it beats TRELLIS by win_margin or more on win_criteria_needed criteria AND its bind gate is no worse.",
    "engines": {
      "trellis": {"script": "run_3d.py", "preset": "tokens98k_fresh", "stage": "trellis", "pipeline": "TRELLIS", "asset_suffix": "-trellis", "guard_match": "generate.py"},
      "pixal3d": {"script": "run_pixal3d.py", "preset": "standard", "stage": "pixal3d", "pipeline": "PIXAL3D", "asset_suffix": "-pixal3d", "guard_match": "pixal3d_entry"}
    },
    "order": ["trellis", "pixal3d"],
    "wall_budget_s": 600,
    "wall_hard_cap_s": 1800,
    "out_subdir": "ab",
    "donor": "tall",
    "bind": {"min_span_over_height": 0.8, "tolerance": 0.0},
    "qc": {"enabled": true, "timeout_s": 600},
    "render": {
      "enabled": true,
      "script": "tools/ab/turntable_blender.py",
      "timeout_s": 3600,
      "resolution": [768, 1024],
      "samples": 32,
      "engine": "CYCLES",
      "device": "CPU",
      "angles_deg": [0, 45, 90, 135, 180, 270],
      "face_crop": {"height_frac": 0.14, "lens_mm": 85, "frame_margin": 1.6},
      "lights": {
        "key": {"energy": 900, "location": [2.5, -3.0, 3.0], "size": 2.0},
        "fill": {"energy": 300, "location": [-3.0, -2.0, 1.5], "size": 3.0},
        "rim": {"energy": 700, "location": [0.0, 3.5, 3.0], "size": 1.5}
      },
      "world": {"color": [0.05, 0.05, 0.05], "strength": 1.0},
      "camera": {"lens_mm": 50, "frame_margin": 1.15, "height_frac": 0.5}
    },
    "scoring": {"criteria": ["face", "hair", "colour_match", "bake_faults"], "min": 0, "max": 10, "win_margin": 1.0, "win_criteria_needed": 2}
  },
  "gates": {
    "_comment": "plugin 0.1.4 gates (plugins/factory/lib/cf_gates.py). token_floor = the robot's proven setting (preset tokens98k); hero stays equal until a higher setting is measured on this GPU; presets with no tier (drafts, benchmark profiles) have no floor. A floor is a minimum, not a cap: any run may sample more. Ceiling test (GPU free only): robot_1076 at 131072 and 196608, --attn-auto-gb 28; hero floor = highest that completes in under 2x the 98304 wall time.",
    "min_subject_frac": 0.6,
    "min_head_px": 512,
    "token_floor": {
      "master": 98304,
      "hero": 98304
    },
    "preset_tier": {
      "hero_rebake": "hero",
      "tokens98k_fresh": "master"
    },
    "lighting_tier_required": "three_point",
    "pipelines": [
      "TRELLIS",
      "PIXAL3D",
      "SCULPT"
    ]
  },
  "motion": {
    "_comment": "plugin 0.1.8 motion_generate (tools/run_motion.py), 0.1.12 second backend. ARDY (nv-tlabs/ardy, Apache-2.0 code, NVIDIA Open Model Agreement weights) in the Motion-312 venv, or Kimodo (nv-tlabs/kimodo, Apache-2.0 code, NVIDIA Open Model License weights) in its own Kimodo-312 venv (transformers 5.1.0 vs ARDY 5.8.1), then a Blender retarget onto psyche-106 into a Mixamo-format clip GLB. Paths live in config.local.json (motion_*, kimodo_*; the Kimodo ones default under work_dir). Text encoder = LLM2Vec on a LOCAL Llama 3 mirror: no network, no token. DRAFT: nothing here has run on a GPU.",
    "backend": "ardy",
    "backends_enabled": ["ardy", "kimodo"],
    "text_encoder_name": "meta-llama/Meta-Llama-3-8B-Instruct",
    "llama_shard_bytes": {
      "model-00001-of-00004.safetensors": 4976698672,
      "model-00002-of-00004.safetensors": 4999802720,
      "model-00003-of-00004.safetensors": 4915916176,
      "model-00004-of-00004.safetensors": 1168138808
    },
    "kimodo_model": "Kimodo-SOMA-RP-v1.2",
    "kimodo_model_dir": "Kimodo-SOMA-RP-v1.2",
    "kimodo_expected_skeleton": "somaskel77",
    "kimodo_fps": 30,
    "kimodo_diffusion_steps": 100,
    "kimodo_weights_bytes": 1133177724,
    "kimodo_venv_name": "Kimodo-312",
    "kimodo_guard_match": "kimodo_generate",
    "kimodo_clip_prefix": "kimodo-",
    "constraints": {
      "types": ["root2d", "fullbody", "left-hand", "right-hand", "left-foot", "right-foot", "end-effector"],
      "joint_counts": [30, 77],
      "max_sets": 8,
      "max_frames_per_set": 16,
      "max_json_bytes": 400000
    },
    "ardy_model": "core40",
    "ardy_model_dir": "ARDY-Core-RP-20FPS-Horizon40",
    "ardy_expected_skeleton": "cskel27",
    "default_duration_s": 4.0,
    "max_duration_s": 10.0,
    "default_seed": 0,
    "text_max_chars": 300,
    "text_encoder_device": "cuda",
    "timeout_s": 3600,
    "retarget_timeout_s": 900,
    "guard_match": "ardy_generate",
    "min_free_ram_gb_encoder_cpu": 24,
    "clip_prefix": "ardy-",
    "clip_ext": ".glb",
    "bone_prefix": "mixamorig:",
    "clip_action_name": "clip",
    "subdir": "motion",
    "retarget": {
      "required_bones": ["Hips", "Spine", "Spine1", "Spine2", "Neck", "Head", "LeftArm", "RightArm", "LeftForeArm", "RightForeArm", "LeftUpLeg", "RightUpLeg", "LeftLeg", "RightLeg", "LeftFoot", "RightFoot"],
      "direction_children": {
        "Hips": "Spine", "Spine": "Spine1", "Spine1": "Spine2", "Spine2": "Neck", "Neck": "Head",
        "LeftShoulder": "LeftArm", "LeftArm": "LeftForeArm", "LeftForeArm": "LeftHand",
        "RightShoulder": "RightArm", "RightArm": "RightForeArm", "RightForeArm": "RightHand",
        "LeftUpLeg": "LeftLeg", "LeftLeg": "LeftFoot", "LeftFoot": "LeftToeBase",
        "RightUpLeg": "RightLeg", "RightLeg": "RightFoot", "RightFoot": "RightToeBase"
      },
      "skeletons": {
        "cskel27": {
          "direct": ["Shoulder", "Arm", "ForeArm", "Hand", "HandThumb1", "UpLeg", "Leg", "Foot", "ToeBase"],
          "renamed": {},
          "center": {"Hips": "Hips", "Spine": "Spine", "Spine1": "Spine2", "Spine2": "Spine3", "Neck": "Neck", "Head": "Head"},
          "fingers": false
        },
        "somaskel77": {
          "_comment": "Kimodo output (SOMA 77 joints). UNRUN name table, same content as SKELETON_TABLES in tools/motion/retarget_blender.py (a test keeps them equal).",
          "direct": ["Shoulder", "Arm", "ForeArm", "Hand", "Foot", "ToeBase"],
          "renamed": {},
          "renamed_sided": {"UpLeg": "Leg", "Leg": "Shin"},
          "center": {"Hips": "Hips", "Spine": "Spine1", "Spine1": "Spine2", "Spine2": "Chest", "Neck": "Neck1", "Head": "Head"},
          "fingers": true
        }
      }
    }
  }
}