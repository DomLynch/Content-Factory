{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gpu_lock_guard.py\"",
            "timeout": 15,
            "if": "Bash(*generate.py*)"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gpu_lock_guard.py\"",
            "timeout": 15,
            "if": "Bash(*flux_kit*)"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gpu_lock_guard.py\"",
            "timeout": 15,
            "if": "Bash(*run_3d*)"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gpu_lock_guard.py\"",
            "timeout": 15,
            "if": "Bash(*run_character*)"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gpu_lock_guard.py\"",
            "timeout": 15,
            "if": "Bash(*run_kit*)"
          }
        ]
      }
    ]
  }
}