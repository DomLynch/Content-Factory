diff --git a/src/model/attn_compat.py b/src/model/attn_compat.py
new file mode 100644
index 0000000..6db0f69
--- /dev/null
+++ b/src/model/attn_compat.py
@@ -0,0 +1,39 @@
+"""flash-attn is optional: use it when it imports (CUDA builds), else PyTorch scaled_dot_product_attention (ROCm, CPU).
+
+flash_attn_func(q, k, v) takes (batch, seq, heads, head_dim) and returns (out, None), the shape contract the callers in this repo expect.
+Force the fallback with SKINTOKENS_ATTN=sdpa.
+"""
+import os
+
+import torch
+import torch.nn.functional as F
+
+try:
+    if os.environ.get("SKINTOKENS_ATTN", "").lower() == "sdpa":
+        raise ImportError("SKINTOKENS_ATTN=sdpa")
+    try:
+        from flash_attn_interface import flash_attn_func as _fa  # FlashAttention 3 returns (out, lse)
+
+        def flash_attn_func(q, k, v, **kwargs):
+            res = _fa(q, k, v, **kwargs)
+            return res if isinstance(res, tuple) else (res, None)
+    except ImportError:
+        from flash_attn.flash_attn_interface import flash_attn_func as _fa2
+
+        def flash_attn_func(q, k, v, **kwargs):
+            return _fa2(q, k, v, **kwargs), None
+    HAS_FLASH = True
+except ImportError:
+    HAS_FLASH = False
+
+    def flash_attn_func(q, k, v, **kwargs):
+        q, k, v = (t.transpose(1, 2) for t in (q, k, v))  # (B, H, L, D)
+        k, v = k.to(q.dtype), v.to(q.dtype)
+        if q.shape[1] != k.shape[1]:
+            rep = q.shape[1] // k.shape[1]
+            k, v = k.repeat_interleave(rep, dim=1), v.repeat_interleave(rep, dim=1)
+        out = F.scaled_dot_product_attention(q, k, v, is_causal=bool(kwargs.get("causal", False)))
+        return out.transpose(1, 2), None  # (B, L, H, D)
+
+
+LLM_ATTN_IMPL = "flash_attention_2" if HAS_FLASH else "sdpa"
